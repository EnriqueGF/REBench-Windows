{
  "profiles": {
    "codex": [
      "codex", "exec", "--skip-git-repo-check", "--sandbox", "workspace-write",
      "--ephemeral", "--color", "never", "-m", "gpt-6-sol", "{prompt}"
    ],
    "claude": [
      "claude", "-p", "{prompt}", "--model", "claude-opus-4-7",
      "--output-format", "text", "--allowedTools", "Bash,Read,Write,Edit,Glob,Grep"
    ],
    "opencode": ["opencode", "run", "{prompt}"]
  }
}
